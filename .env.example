# Home Assistant base URL; use the URL your browser can reach.
VITE_HA_URL=http://homeassistant.local:8123

# Paste a Home Assistant Long-Lived Access Token here. Keep .env local and untracked.
VITE_HA_TOKEN=your_long_lived_access_token

# Home coordinates stay in .env; the local server uses these for aircraft distance filtering.
HOME_LATITUDE=
HOME_LONGITUDE=
